{
  "version": 1,
  "name": "pi-profile",
  "description": "Portable Pi skills, extensions, and package configuration.",
  "packages": [
    {
      "id": "agent-stuff",
      "kind": "git",
      "repository": "https://github.com/winterstream/agent-stuff.git",
      "ref": "main",
      "ownership": "owned",
      "editPolicy": "edit-source-and-push"
    },
    {
      "id": "pi-ghostty",
      "kind": "git",
      "repository": "https://github.com/HazAT/pi-ghostty.git",
      "ref": "main",
      "ownership": "external",
      "editPolicy": "fork-or-upstream-pr"
    },
    {
      "id": "pi-subagents",
      "kind": "git",
      "repository": "https://github.com/nicobailon/pi-subagents.git",
      "ref": "main",
      "ownership": "external",
      "editPolicy": "fork-or-upstream-pr"
    },
    {
      "id": "pi-jj",
      "kind": "git",
      "repository": "https://github.com/manojlds/pi-jj.git",
      "ref": "main",
      "ownership": "external",
      "editPolicy": "fork-or-upstream-pr"
    },
    {
      "id": "pi-blackhole",
      "kind": "npm",
      "package": "pi-blackhole",
      "version": "0.4.5",
      "ownership": "external",
      "editPolicy": "upstream-or-fork"
    },
    {
      "id": "pi-autoresearch",
      "kind": "npm",
      "package": "pi-autoresearch",
      "version": "1.6.2",
      "ownership": "external",
      "editPolicy": "upstream-or-fork"
    },
    {
      "id": "pi-wayfinder",
      "kind": "npm",
      "package": "@deevus/pi-wayfinder",
      "version": "0.3.2",
      "ownership": "external",
      "editPolicy": "upstream-or-fork"
    }
  ]
}
