#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

expected="$(profile_entries_json)"
mkdir -p "$(dirname "$PROFILE_SETTINGS")"
tmp="$(mktemp "${TMPDIR:-/tmp}/pi-profile-settings.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
jq -n --argjson packages "$expected" '{packages: $packages}' > "$tmp"
mv "$tmp" "$PROFILE_SETTINGS"
trap - EXIT
printf 'generated %s\n' "$PROFILE_SETTINGS"
