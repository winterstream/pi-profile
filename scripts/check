#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

jq empty "$PROFILE_FILE"
jq empty "$PROFILE_LOCK"
jq empty "$PROFILE_SETTINGS"

jq -e '
  .version == 1
  and (.packages | type == "array")
  and (([.packages[].id] | length) == ([.packages[].id] | unique | length))
  and all(.packages[]; (.kind == "git" or .kind == "npm"))
' "$PROFILE_FILE" >/dev/null

jq -e --slurpfile lock "$PROFILE_LOCK" '
  ($lock[0].version == 1)
  and (([.packages[].id] | sort) == ($lock[0].packages | keys | sort))
  and all($lock[0].packages[];
    if .kind == "git" then
      (.revision | test("^[0-9a-f]{40}$"))
      and (.source | test("^git:.+@[0-9a-f]{40}$"))
    elif .kind == "npm" then
      (.source | test("^npm:.+@[^@]+$"))
    else false
    end
  )
' "$PROFILE_FILE" >/dev/null

expected="$(profile_entries_json)"
actual="$(jq -c '.packages // []' "$PROFILE_SETTINGS")"
if ! jq -n -e --argjson expected "$expected" --argjson actual "$actual" '$expected == $actual' >/dev/null; then
  echo "$PROFILE_SETTINGS is stale; run scripts/sync-settings" >&2
  exit 1
fi

printf 'profile manifest, lockfile, and generated settings are valid\n'
